# Asosiy muhit o'zgaruvchilari uchun shablon
# Ushbu faylni serverda .env deb nomlab, haqiqiy ma'lumotlar bilan to'ldiring.

# Server porti (masalan, 3000)
PORT=3000

# Telegram Bot Token (BotFather dan olingan)
BOT_TOKEN=your_telegram_bot_token_here

# Dev/Test bot tokeni (ixtiyoriy, agar test uchun botingiz bo'lsa)
DEV_BOT_TOKEN=your_dev_telegram_bot_token_here

# Super Admin ning Telegram ID si (Raqamli formatda)
SUPER_ADMIN_ID=123456789

# Ma'lumotlar bazasi URL manzili (Supabase, Neon yoki mahalliy PostgreSQL uchun)
# PostgreSQL Connection String formatida
DATABASE_URL=postgres://user:password@host:port/dbname
